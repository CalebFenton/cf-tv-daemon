#!/bin/sh
# snap - capture the TV screen to a local file, fast.
#
# One channel command (tv/chan.py) captures and transfers, so the whole loop is
# a single round trip.
#
# Usage:  bin/snap [--tv NAME] [output.jpg]
#
# The probe lives in /opt/cap, on the persistent /opt partition. /tmp is tmpfs
# and is wiped on reboot, which is what made capture appear to "just stop
# working" after a power cycle: the DLL was gone. Do not move it back.

set -u
cd "$(dirname "$0")/.." 2>/dev/null || exit 98

if [ "${1:-}" = "--tv" ]; then
    export CF_TV_NAME="${2:?--tv needs a name}"  # what --tv sets in the Python tools
    shift 2
fi
OUT=${1:-/tmp/snap.jpg}
PY=.venv/bin/python
PROBE=/opt/cap/CaptureProbe.dll
REMOTE=/opt/cap/.snap.jpg
TMP=$(mktemp -d) || exit 1
trap 'rm -rf "$TMP"' EXIT

snap_once() {
    "$PY" tv/chan.py run "/usr/bin/dotnet $PROBE $REMOTE 2>&1; base64 -w0 $REMOTE" \
        > "$TMP/b64" 2> "$TMP/err"
}

snap_once
rc=$?

# channel_down means the agent died (standby/reboot). Bring it back and retry.
if [ $rc -ne 0 ] || [ ! -s "$TMP/b64" ]; then
    if grep -qi 'channel_down\|no_daemon\|refused' "$TMP/err" "$TMP/b64" 2>/dev/null; then
        echo "snap: channel down, restarting..." >&2
        "$PY" -c 'import sys; sys.path.insert(0, "tv"); import root; sys.exit(0 if root.channel_start() else 1)' \
            && snap_once
        rc=$?
    fi
fi

if [ $rc -ne 0 ] || [ ! -s "$TMP/b64" ]; then
    cat "$TMP/err" >&2
    echo "snap: channel failed" >&2
    exit 1
fi

# If the probe failed it prints its error before the payload; an empty payload
# means no file was written. Take the last line only: it is the base64 blob.
tail -n 1 "$TMP/b64" | base64 -d > "$OUT" 2>/dev/null
if [ ! -s "$OUT" ]; then
    echo "snap: empty output; probe said:" >&2
    grep -v '^[A-Za-z0-9+/=]\{80,\}$' "$TMP/b64" | head -5 >&2
    exit 1
fi

echo "$OUT $(stat -c%s "$OUT") bytes"
