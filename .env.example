# Copy to .env (not in git). tv/project_env.py loads it for every tv/ and bin/ command.
#
# TVs are named in devices.toml, written by `tv/devices.py scan`; that is the
# normal way to select one, and it survives a DHCP address change. This file is
# the fallback for a single TV with no devices.toml: the TV's LAN address
# (Settings > General > Network > Network Status).
CF_TV_IP=192.0.2.10

# The TV every command uses when --tv is absent, overriding devices.toml's
# `default`. Optional.
# CF_TV_NAME=qn85d
# The registry file, if it is not <repo>/devices.toml. Optional.
# CF_TV_DEVICES=/path/to/devices.toml
